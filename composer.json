{
    "name": "mergocz/semaco-eshop",
    "type": "project",
    "description": "E-shop SeMaCo (Sylius 2.2)",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "behat/transliterator": "^1.5",
        "dompdf/dompdf": "^3.1.6",
        "dragonmantank/cron-expression": "^3.4",
        "knplabs/knp-gaufrette-bundle": "^0.9.0",
        "sylius/sylius": "~2.2.12",
        "symfony/dotenv": "^7.4.18",
        "symfony/flex": "^2.11",
        "symfony/http-client": "^7.4",
        "symfony/lock": "^7.4",
        "symfony/rate-limiter": "^7.4",
        "symfony/runtime": "^7.4.21",
        "symfony/scheduler": "^7.4"
    },
    "require-dev": {
        "behat/behat": "^3.34",
        "behat/mink-selenium2-driver": "^1.7",
        "dbrekelmans/bdi": "^1.4.1",
        "dmore/behat-chrome-extension": "^1.5.0",
        "dmore/chrome-mink-driver": "^2.11.1",
        "friends-of-behat/exclude-specifications-extension": "^0.4.0",
        "friends-of-behat/mink": "^1.11",
        "friends-of-behat/mink-browserkit-driver": "^1.6.3",
        "friends-of-behat/mink-debug-extension": "^2.2",
        "friends-of-behat/mink-extension": "^2.7.5",
        "friends-of-behat/page-object-extension": "^0.3.2",
        "friends-of-behat/suite-settings-extension": "^1.2",
        "friends-of-behat/symfony-extension": "^2.7.0",
        "friends-of-behat/variadic-extension": "^1.7",
        "lchrusciel/api-test-case": "^5.3.5",
        "nyholm/psr7": "^1.8.2",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.1",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5.66",
        "robertfausk/behat-panther-extension": "^1.2",
        "sylius-labs/coding-standard": "^4.5.1",
        "sylius-labs/suite-tags-extension": "~0.2",
        "sylius/sylius-rector": "^3.9",
        "symfony/browser-kit": "^7.4.21",
        "symfony/contracts": "^3.7.3",
        "symfony/debug-bundle": "^7.4.8",
        "symfony/intl": "^7.4.17",
        "symfony/web-profiler-bundle": "^7.4.21"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": false,
            "rector/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "symfony/thanks": false
        },
        "bump-after-update": false
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "^7.4",
            "endpoint": [
                "https://api.github.com/repos/Sylius/SyliusRecipes/contents/index.json?ref=flex/main",
                "flex://defaults"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        },
        "classmap": [
            "src/Kernel.php"
        ]
    },
    "prefer-stable": true,
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "post-create-project-cmd": [],
        "remove-lockfiles-from-gitignore": "@php -r \"file_put_contents('.gitignore', str_replace(['/composer.lock' . PHP_EOL, '/yarn.lock' . PHP_EOL], '', file_get_contents('.gitignore')));\"",
        "rector-dry-run": "vendor/bin/rector process --dry-run",
        "rector-apply": "vendor/bin/rector process",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "replace": {
        "symfony/polyfill-apcu": "*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-intl": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-icu": "*",
        "symfony/polyfill-intl-idn": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    }
}
