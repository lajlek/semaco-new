{% import '@SyliusShop/shared/macro/loader.html.twig' as loader %}

<div class="position-relative" {{ attributes }}>
    {{ loader.render() }}
    <section class="semaco-cart-summary mb-4" aria-labelledby="cart-summary-heading">
        <h2 class="h4" id="cart-summary-heading">{{ 'sylius.ui.summary'|trans }}</h2>
        {% hook 'summary' with {cart} %}
    </section>
</div>
