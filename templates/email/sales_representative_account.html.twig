{% extends 'email/layout.html.twig' %}

{% block subject %}Přístup do e-shopu SEMACO{% endblock %}

{% block content %}
    {% set url = sylius_channel_url(path('sylius_shop_password_reset', {token: user.passwordResetToken, _locale: localeCode}), channel) %}
    <p>Dobrý den,</p>
    <p>byl Vám založen účet obchodníka v e-shopu SEMACO. Přihlašovací jméno: {{ user.username }}</p>
    <p>Heslo si nastavte přes tento odkaz: <a href="{{ url }}">{{ url }}</a></p>
    <p>Pokud odkaz mezitím vyprší, použijte na přihlašovací stránce volbu „Zapomenuté heslo“.</p>
    <p>Tým SEMACO</p>
{% endblock %}
