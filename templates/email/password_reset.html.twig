{% extends 'email/layout.html.twig' %}

{% block subject %}Přihlašovací údaje{% endblock %}

{% block content %}
    {% set url = sylius_channel_url(path('sylius_shop_password_reset', {token: user.passwordResetToken, _locale: localeCode}), channel) %}
    <p>Vážený uživateli,</p>
    <p>pro přihlášení uživatelským jménem {{ user.username }} prosím použijte následující odkaz: <a href="{{ url }}">{{ url }}</a></p>
    <p>Děkujeme, tým SEMACO</p>
{% endblock %}
