{% extends 'email/layout.html.twig' %}

{% block subject %}Ověření e-mailové adresy{% endblock %}

{% block content %}
    {% set url = sylius_channel_url(path('sylius_shop_user_verification', {token: user.emailVerificationToken, _locale: localeCode}), channel) %}
    <p>Pro ověření e-mailové adresy prosím otevřete odkaz: <a href="{{ url }}">{{ url }}</a></p>
    <p>Děkujeme, tým SEMACO</p>
{% endblock %}
