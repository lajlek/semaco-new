{# Rendered with \Sylius\Bundle\ShopBundle\Twig\Component\Common\TaxonMenuComponent #}
<section {{ attributes }}>
    <div class="row">
        {% for taxon in taxons|filter(taxon => app_taxon_has_products(taxon)) %}
            <div class="col-sm-6 col-lg-4 mb-4">
                <div class="category category-absolute category-classic">
                    <a href="{{ path('semaco_shop_product_list', {'slug': taxon.slug, '_locale': taxon.translation.locale}) }}">
                        <figure class="category-media">
                            {% set taxon_image = taxon.images.first %}
                            {% if taxon_image %}
                                <img src="{{ taxon_image.path|imagine_filter(taxon.code starts with constant('App\\Catalog\\BrandMenu\\BrandMenuTree::CODE_PREFIX') ? 'semaco_brand_thumbnail' : 'semaco_taxon_thumbnail') }}" alt="{{ taxon.name }}" />
                            {% else %}
                                <img src="{{ asset('bundles/syliusui/images/400x300.png') }}" alt="{{ taxon.name }}" />
                            {% endif %}
                        </figure>
                        <div class="category-content">
                            <h4 class="category-name">{{ taxon.name }}</h4>
                        </div>
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>
</section>
