<div class="col-lg-4 col-md-6">
    <div class="widget ml-lg-4">
        <h4 class="widget-title">{{ 'app.shop.footer.my_account'|trans }}</h4>
        <ul class="widget-body">
            <li>
                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('sylius_shop_account_dashboard') }}">{{ 'app.shop.footer.my_account'|trans }}</a>
                {% else %}
                    <a href="{{ path('sylius_shop_login') }}">{{ 'app.shop.footer.sign_in'|trans }}</a>
                {% endif %}
            </li>
            <li><a href="{{ path('sylius_shop_cart_summary') }}">{{ 'app.shop.cart.title'|trans }}</a></li>
            {% if is_granted('ROLE_USER') %}
                <li><a href="{{ path('sylius_shop_account_order_index') }}">{{ 'app.shop.footer.my_orders'|trans }}</a></li>
            {% endif %}
        </ul>
    </div>
</div>
