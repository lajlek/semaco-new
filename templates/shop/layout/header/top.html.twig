<div class="header-top">
    <div class="container">
        <div class="header-left">{% hook 'top_left' %}</div>
        <div class="header-right">
            <a href="mailto:{{ 'app.shop.header.email'|trans }}" class="header-contact"><i class="fas fa-envelope" aria-hidden="true"></i>&nbsp;&nbsp;{{ 'app.shop.header.email'|trans }}</a>
            <a href="tel:{{ 'app.shop.header.phone'|trans|replace({' ': ''}) }}" class="header-contact"><i class="fas fa-phone" aria-hidden="true"></i>&nbsp;&nbsp;{{ 'app.shop.header.phone'|trans }}</a>
        </div>
    </div>
</div>
