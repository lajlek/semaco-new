{# Rendered with \Sylius\Bundle\ShopBundle\Twig\Component\Product\BreadcrumbComponent #}
{% set has_parent = taxon.parent is not empty and not taxon.parent.isRoot() %}
{% set children = taxon.enabledChildren|filter(child => app_taxon_has_products(child)) %}
<div class="widget" {{ attributes }}>
    <h3 class="widget-title">{{ taxon.name }}</h3>
    {% if has_parent or children|length > 0 %}
        <ul class="widget-body filter-items search-ul">
            {% if has_parent %}
                <li>
                    <a href="{{ path('semaco_shop_product_list', {'slug': taxon.parent.slug, '_locale': taxon.parent.translation.locale}) }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-chevron-up" aria-hidden="true"></i> {{ 'app.shop.listing.level_up'|trans }}
                    </a>
                </li>
            {% endif %}
            {% for child in children %}
                <li><a href="{{ path('semaco_shop_product_list', {'slug': child.slug, '_locale': child.translation.locale}) }}" class="list-group-item list-group-item-action">{{ child.name }}</a></li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
