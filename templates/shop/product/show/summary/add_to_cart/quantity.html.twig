{% set quantity_step = product.quantityStep is defined ? max(product.quantityStep, 1) : 1 %}
{% set minimum_quantity = product.minimumQuantity is defined ? max(product.minimumQuantity, quantity_step) : 1 %}

<div class="row align-items-end mt-10">
    {% if quantity_step > 1 %}
        <p class="w-100">{{ 'app.shop.product.quantity_step_notice'|trans({'%step%': quantity_step}) }}</p>
    {% endif %}
    <div class="product-form product-qty">
        <div class="product-form-group">
            <div class="input-group">
                <button class="quantity-minus d-icon-minus" type="button" aria-label="{{ 'app.shop.product.quantity_minus'|trans }}"></button>
                {{ form_widget(form.cartItem.quantity, {'attr': {'class': 'quantity form-control', 'min': minimum_quantity, 'step': quantity_step, 'data-step': quantity_step, 'aria-label': 'app.shop.product.quantity'|trans}}) }}
                <button class="quantity-plus d-icon-plus" type="button" aria-label="{{ 'app.shop.product.quantity_plus'|trans }}"></button>
            </div>
            {% set selected_variant = form.cartItem.vars.value.variant %}
            <button type="submit" class="btn btn-primary btn-add-to-cart"{% if not form.vars.valid or selected_variant is null or not selected_variant.enabled %} disabled{% endif %}>
                <span class="btn-icon"><i class="fas fa-shopping-bag" aria-hidden="true"></i></span>
                {{ 'app.shop.product.add_to_cart'|trans }}
            </button>
        </div>
    </div>
</div>
