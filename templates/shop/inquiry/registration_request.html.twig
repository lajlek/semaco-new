{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% form_theme form '@SyliusShop/form/theme.html.twig' %}

{% block title %}{{ 'app.inquiry.registration_request.title'|trans({}, 'inquiry') }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="page-header" style="background-color: #285da8;">
        <h1 class="page-title">{{ 'app.inquiry.registration_request.title'|trans({}, 'inquiry') }}</h1>
    </div>
    <div class="page-content mt-10 pt-7">
        <section class="contact-section">
            <div class="container">
                <div class="row">
                    <div class="col-12 mb-4">
                        <h2 class="h4 ls-m font-weight-bold">{{ 'app.inquiry.registration_request.form_title'|trans({}, 'inquiry') }}</h2>
                        {{ form_start(form, {attr: {id: 'registration_request_form', class: 'pl-lg-2'}}) }}
                            {{ form_errors(form) }}
                            <div class="row mb-2">
                                <div class="col-md-6 mb-4">{{ form_row(form.companyName) }}</div>
                                <div class="col-md-6 mb-4">{{ form_row(form.identificationNumber) }}</div>
                                <div class="col-md-6 mb-4">{{ form_row(form.street) }}</div>
                                <div class="col-md-6 mb-4">{{ form_row(form.streetNumber) }}</div>
                                <div class="col-md-6 mb-4">{{ form_row(form.city) }}</div>
                                <div class="col-md-6 mb-4">{{ form_row(form.postcode) }}</div>
                                <div class="col-md-6 mb-4">{{ form_row(form.email) }}</div>
                                <div class="col-md-6 mb-4">{{ form_row(form.phone) }}</div>
                                <div class="col-md-6 mb-4">{{ form_row(form.firstName) }}</div>
                                <div class="col-md-6 mb-4">{{ form_row(form.lastName) }}</div>
                                <div class="col-12">{{ form_row(form.message) }}</div>
                            </div>
                            {% include 'shop/inquiry/_form_footer.html.twig' with {form_id: 'registration_request_form'} %}
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
