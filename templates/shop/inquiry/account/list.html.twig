{% set messages = hookable_metadata.context.messages %}

{% if messages is empty %}
    <div class="alert alert-info">
        {{ 'app.inquiry.account.empty'|trans({}, 'inquiry') }}
        <a href="{{ path('sylius_shop_contact_request') }}">{{ 'app.inquiry.contact.title'|trans({}, 'inquiry') }}</a>
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">{{ 'app.inquiry.account.sent_at'|trans({}, 'inquiry') }}</th>
                    <th scope="col">{{ 'app.inquiry.field.message'|trans({}, 'inquiry') }}</th>
                    <th scope="col">{{ 'app.inquiry.account.answers'|trans({}, 'inquiry') }}</th>
                    <th scope="col"><span class="visually-hidden">{{ 'sylius.ui.actions'|trans }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for message in messages %}
                    <tr>
                        <td class="text-nowrap">{{ message.createdAt|date('d. m. Y H:i') }}</td>
                        <td>{{ message.message|u.truncate(90, '…') }}</td>
                        <td>{{ message.answers|filter(a => a.fromAdmin)|length }}</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('app_shop_account_contact_message_show', {id: message.id}) }}">{{ 'sylius.ui.show'|trans }}</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
