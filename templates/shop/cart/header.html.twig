<div class="row align-items-center semaco-page-header">
    <div class="col-lg-8">
        <h1 class="mb-0">{{ 'sylius.ui.your_shopping_cart'|trans }}</h1>
    </div>
    {% if clear_cart|default(false) %}
        <div class="col-lg-4 mt-3 mt-lg-0 text-lg-end">
            <button
                class="btn btn-secondary btn-sm"
                type="button"
                data-action="live#action:prevent"
                data-live-action-param="clearCart"
                {{ sylius_test_html_attribute('clear-cart') }}
            >
                {{ 'sylius.ui.clear_cart'|trans }}
            </button>
        </div>
    {% endif %}
</div>
