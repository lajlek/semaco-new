{% form_theme form 'bootstrap_5_layout.html.twig' %}

<div class="card">
    <div class="card-header"><h3 class="card-title">Odpovědět zákazníkovi</h3></div>
    <div class="card-body">
        {{ form_start(form) }}
        {{ form_row(form.message) }}
        <p class="text-secondary small">Odpověď se zákazníkovi odešle e-mailem a uloží do vlákna.</p>
        <button type="submit" class="btn btn-primary">{{ ux_icon('tabler:send', {class: 'icon'}) }} Odeslat odpověď</button>
        {{ form_end(form) }}
    </div>
</div>
