{% set request = hookable_metadata.context.resource %}

<div class="page-body">
    <div class="container-xl">
        <div class="row">
            <div class="col-12 col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header"><h3 class="card-title">Firma</h3></div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-5">Název společnosti</dt><dd class="col-7">{{ request.companyName }}</dd>
                            <dt class="col-5">IČ</dt><dd class="col-7">{{ request.identificationNumber }}</dd>
                            <dt class="col-5">Ulice</dt><dd class="col-7">{{ request.street }} {{ request.streetNumber }}</dd>
                            <dt class="col-5">Město</dt><dd class="col-7">{{ request.postcode }} {{ request.city }}</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header"><h3 class="card-title">Kontakt</h3></div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-5">Jméno</dt><dd class="col-7">{{ request.fullName }}</dd>
                            <dt class="col-5">E-mail</dt><dd class="col-7"><a href="mailto:{{ request.email }}">{{ request.email }}</a></dd>
                            <dt class="col-5">Telefon</dt><dd class="col-7">{% if request.phone %}<a href="tel:{{ request.phone|replace({' ': ''}) }}">{{ request.phone }}</a>{% endif %}</dd>
                            <dt class="col-5">Zákaznický účet</dt><dd class="col-7">{% if request.customer %}<a href="{{ path('sylius_admin_customer_show', {id: request.customer.id}) }}">{{ request.customer.email }}</a>{% else %}—{% endif %}</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-12 mb-3">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Poznámka</h3></div>
                    <div class="card-body">{{ request.message ? request.message|nl2br : '—' }}</div>
                    <div class="card-footer text-secondary small">
                        Odesláno {{ request.createdAt|date('d. m. Y H:i') }}{% if request.ip %} · IP {{ request.ip }}{% endif %}{% if request.userAgent %} · {{ request.userAgent }}{% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
