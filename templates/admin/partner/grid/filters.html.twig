{% from "@SyliusAdmin/shared/helper/accordion.html.twig" import accordion %}
{% import "@SyliusAdmin/shared/helper/button.html.twig" as button %}

{% set resources = hookable_metadata.context.resources|default(null) %}

{% set path = path(app.request.attributes.get('_route'), app.request.attributes.all('_route_params')) %}
{% set criteria = app.request.query.all('criteria') %}
{% set are_criteria_set = criteria.search.value|default('') != '' or criteria.matchStatus|default('') != '' or criteria.grouping|default('') != '' %}

<div class="position-relative z-1 bg-white mb-3">
    {% set content %}
        <div class="mb-3">
            <form method="get" action="{{ path }}" novalidate>
                <div class="sylius-filters">
                    {% for filter in resources.definition.enabledFilters|filter(filter => filter.enabled)|sylius_sort_by('position') %}
                        <div class="sylius-filters__item">
                            {{ sylius_grid_render_filter(resources, filter) }}
                        </div>
                    {% endfor %}
                </div>
                <div>
                    {{ button.primary({ text: 'sylius.ui.filter'|trans, icon: 'tabler:adjustments', type: 'submit' }) }}
                    {{ button.default({ text: 'sylius.ui.reset'|trans, url: path }) }}
                </div>
            </form>
        </div>
    {% endset %}

    {{ accordion([{
        title: 'sylius.ui.filters'|trans,
        content: content,
        icon: 'tabler:adjustments',
    }], are_criteria_set) }}
</div>
