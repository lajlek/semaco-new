<div class="row g-3 mb-3">
    <div class="col-12 col-xl-5">
        <div class="card h-100">
            <div class="card-header"><h3 class="card-title">Načíst výpis partnera</h3></div>
            <div class="card-body">
                <form method="post" action="{{ path('app_admin_partner_fetch_run_queue') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('partner_fetch') }}">
                    <div class="row g-2">
                        <div class="col-4">
                            <select name="partner" class="form-select" required aria-label="Partner">
                                {% for code, rule in partner_rules() %}
                                    <option value="{{ code }}"{% if rule.allowedHosts is empty %} disabled{% endif %}>{{ rule.label }}{% if rule.allowedHosts is empty %} (jen ruční import){% endif %}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-8">
                            <input type="url" name="url" class="form-control" placeholder="https://… adresa kategorie nebo rodiny" required aria-label="Adresa kategorie nebo rodiny">
                        </div>
                        <div class="col-4">
                            <input type="number" name="max_pages" class="form-control" min="1" max="30" value="5" title="Nejvýš stránek výpisu" aria-label="Nejvýš stránek výpisu">
                        </div>
                        <div class="col-8">
                            <button type="submit" class="btn btn-primary w-100">{{ ux_icon('tabler:download', {class: 'icon'}) }} Zařadit načtení</button>
                        </div>
                    </div>
                    <p class="text-secondary small mt-2 mb-0">
                        Stránky se stahují po jedné s odstupem nejméně 10 s podle robots.txt partnera, nejvýš 30 stránek najednou.
                        Stejnou adresu lze znovu načíst nejdřív po 6 hodinách. POKOLM automatické načítání zakazuje.
                    </p>
                </form>
                <hr class="my-3">
                <form method="post" action="{{ path('app_admin_partner_item_import_html') }}" enctype="multipart/form-data">
                    <input type="hidden" name="_token" value="{{ csrf_token('partner_import') }}">
                    <div class="row g-2">
                        <div class="col-4">
                            <select name="partner" class="form-select" required aria-label="Partner">
                                {% for code, rule in partner_rules() %}
                                    <option value="{{ code }}">{{ rule.label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-8">
                            <input type="file" name="html" accept=".html,.htm,text/html" class="form-control" required aria-label="Uložená stránka (.html)">
                        </div>
                        <div class="col-8">
                            <input type="url" name="url" class="form-control" placeholder="https://… adresa uložené stránky (nepovinné)" aria-label="Adresa uložené stránky">
                        </div>
                        <div class="col-4">
                            <button type="submit" class="btn w-100">{{ ux_icon('tabler:upload', {class: 'icon'}) }} Nahrát stránku</button>
                        </div>
                    </div>
                    <p class="text-secondary small mt-2 mb-0">Pro POKOLM: otevřete výpis kategorie v prohlížeči, uložte ho (Ctrl+S) a nahrajte. Na web partnera se nic neodesílá.</p>
                </form>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-7">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title">Poslední načítání</h3>
                <div class="card-actions d-flex gap-2">
                    <form method="post" action="{{ path('app_admin_partner_item_prepare') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('partner_prepare') }}">
                        <button type="submit" class="btn btn-sm">{{ ux_icon('tabler:refresh', {class: 'icon'}) }} Přepočítat párování a návrhy</button>
                    </form>
                    {% for code, count in partner_details_pending() %}
                        {% if count > 0 %}
                            <form method="post" action="{{ path('app_admin_partner_fetch_run_details') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('partner_fetch') }}">
                                <input type="hidden" name="partner" value="{{ code }}">
                                <button type="submit" class="btn btn-sm" title="Načte parametry z detailu artiklu, nejvýš 30 najednou">{{ ux_icon('tabler:list-details', {class: 'icon'}) }} Detaily {{ partner_rules()[code].label }} ({{ count }})</button>
                            </form>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm card-table">
                    <tbody>
                    {% for run in runs %}
                        <tr>
                            <td class="text-nowrap">{{ run.requestedAt|date('d. m. H:i') }}</td>
                            <td>{{ partner_rules()[run.partnerCode].label|default(run.partnerCode) }}</td>
                            <td class="text-truncate" style="max-width: 12rem" title="{{ run.url }}">{{ run.kind == 'details' ? 'Detaily artiklů' : (run.kind == 'category' ? 'Kategorie: ' ~ run.url : run.url) }}</td>
                            <td class="text-nowrap">{{ status_labels[run.status]|default(run.status) }}</td>
                            <td class="text-nowrap">{{ run.pages }} str. · nové {{ run.itemsCreated }} · změněné {{ run.itemsChanged }}</td>
                            <td class="small text-secondary">
                                {{ run.message }}
                                {% if run.status == 'queued' %}
                                    <form method="post" action="{{ path('app_admin_partner_fetch_run_cancel', {id: run.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('partner_fetch') }}">
                                        <button type="submit" class="btn btn-sm btn-link p-0">Zrušit</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td class="text-secondary">Zatím nic.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{% set category_states = {idle: 'Nenačteno', running: 'Načítá se', paused: 'Pozastaveno', done: 'Načteno'} %}
{% set automatic_partners = partner_rules()|filter(rule => rule.allowedHosts is not empty) %}
{% set categories_by_partner = partner_categories() %}

<div class="card mb-3">
    <div class="card-header"><h3 class="card-title">Sledované kategorie partnerů</h3></div>
    <div class="card-body">
        <form method="post" action="{{ path('app_admin_partner_category_selection') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('partner_category') }}">
            <div class="table-responsive">
                <table class="table table-sm mb-3">
                    <thead>
                    <tr><th class="w-1">Vybrat</th><th>Partner</th><th>Kategorie</th><th>Zdroj</th><th>Stav</th><th class="w-1"></th></tr>
                    </thead>
                    <tbody>
                    {% for code, rule in automatic_partners %}
                        {% for category in categories_by_partner[code]|default([]) %}
                            <tr>
                                <td><input type="checkbox" class="form-check-input" name="enabled[]" value="{{ category.id }}"{% if category.enabled %} checked{% endif %} aria-label="Vybrat {{ category.name }}"></td>
                                <td>{{ rule.label }}</td>
                                <td>{{ category.name }}</td>
                                <td class="text-secondary small">{{ category.urlKeywords ? 'adresa obsahuje: ' ~ category.urlKeywords : category.startUrl }}</td>
                                <td class="text-nowrap">
                                    {{ category_states[category.state] }}
                                    {% if category.pendingUrls is not null %}· načteno {{ category.pagesFetched }}, zbývá {{ category.pendingUrls|length }} str.{% endif %}
                                    {% if category.finishedAt %}· {{ category.finishedAt|date('d. m. H:i') }}{% endif %}
                                </td>
                                <td>{% if not category.enabled %}<button type="submit" form="partner-category-delete-{{ category.id }}" class="btn btn-sm btn-link p-0">Smazat</button>{% endif %}</td>
                            </tr>
                        {% endfor %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <button type="submit" class="btn btn-primary">{{ ux_icon('tabler:device-floppy', {class: 'icon'}) }} Uložit výběr</button>
        </form>
        {% for categories in categories_by_partner %}
            {% for category in categories|filter(category => not category.enabled) %}
                <form id="partner-category-delete-{{ category.id }}" method="post" action="{{ path('app_admin_partner_category_delete', {id: category.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('partner_category') }}">
                </form>
            {% endfor %}
        {% endfor %}
        <div class="d-flex flex-wrap gap-2 mt-3">
            {% for code, rule in automatic_partners %}
                <form method="post" action="{{ path('app_admin_partner_fetch_run_categories') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('partner_fetch') }}">
                    <input type="hidden" name="partner" value="{{ code }}">
                    <button type="submit" class="btn">{{ ux_icon('tabler:download', {class: 'icon'}) }} Načíst vybrané: {{ rule.label }}</button>
                </form>
            {% endfor %}
        </div>
        <p class="text-secondary small mt-2 mb-0">
            Načítání běží po částech: nejvýš 30 stránek za hodinu s odstupem nejméně 10 s. Odškrtnutím a uložením se pozastaví.
            U BRW se berou jen rodiny s FUTURO nebo NERIOX v názvu a z kategorií frézování, vrtání, závitování, zahlubování, vystružování, soustružení a NERIOX Fertigungstechnik. Ostatní se po stažení přeskočí. POKOLM se načítá jen nahráním uložené stránky.
        </p>
        <hr class="my-3">
        <form method="post" action="{{ path('app_admin_partner_category_create') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('partner_category') }}">
            <div class="row g-2">
                <div class="col-6 col-xl-2">
                    <select name="partner" class="form-select" required aria-label="Partner">
                        {% for code, rule in automatic_partners %}
                            <option value="{{ code }}">{{ rule.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-6 col-xl-3"><input type="text" name="name" class="form-control" maxlength="255" required placeholder="Název kategorie" aria-label="Název kategorie"></div>
                <div class="col-6 col-xl-2"><input type="text" name="url_keywords" class="form-control" maxlength="255" placeholder="Slova v adrese (BRW)" aria-label="Slova v adrese produktu"></div>
                <div class="col-6 col-xl-3"><input type="url" name="start_url" class="form-control" placeholder="https://… adresa výpisu" aria-label="Adresa výpisu kategorie"></div>
                <div class="col-12 col-xl-2"><button type="submit" class="btn w-100">{{ ux_icon('tabler:plus', {class: 'icon'}) }} Přidat kategorii</button></div>
            </div>
        </form>
    </div>
</div>
